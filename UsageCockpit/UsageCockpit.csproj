<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UsageIACockpit</AssemblyName>
    <RootNamespace>UsageCockpit</RootNamespace>
    <Version>0.2.2</Version>
    <!-- Nome exibido (Gerenciador de Tarefas, propriedades do exe). A pasta de dados continua
         %APPDATA%\UsageCockpit para não perder as configurações de quem já usa o app. -->
    <Product>Usage IA Cockpit</Product>
    <AssemblyTitle>Usage IA Cockpit</AssemblyTitle>
    <Description>Monitor de uso do Claude Code e do Codex</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- O DPI PerMonitorV2 fica no app.manifest porque a janela é WPF; o aviso é do analisador do WinForms. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Só as traduções do WPF/WinForms que o app usa; as demais somam vários MB sem uso. -->
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
