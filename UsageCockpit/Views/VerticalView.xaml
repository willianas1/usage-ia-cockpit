<UserControl x:Class="UsageCockpit.Views.VerticalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UsageCockpit.Controls">
    <UserControl.Resources>
        <!-- Detalhe semanal, mostrado ao passar o mouse sobre o mini velocímetro -->
        <ToolTip x:Key="WeekTip" x:Shared="False" Background="#15181D" BorderBrush="#2D333B" Padding="10,8"
                 Placement="Left" HorizontalOffset="-6">
            <StackPanel Width="200">
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="{Binding WeekPercentText}" DockPanel.Dock="Right" FontSize="12"
                               FontFamily="{StaticResource MonoFont}" Foreground="{Binding WeekLevelBrush}"/>
                    <TextBlock Text="Uso semanal" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                </DockPanel>
                <c:FuelBar Percent="{Binding WeekPercent}" HasData="{Binding HasData}" Brand="{Binding Brand}"/>
                <TextBlock Text="{Binding WeekResetText}" FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock FontSize="11" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}">
                    <Run Text="Sessão 5h:"/>
                    <Run Text="{Binding SessionPercentText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                    <Run Text="·"/>
                    <Run Text="{Binding SessionResetText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Error}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource WarnBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ToolTip>

        <!-- Uma conta: mini velocímetro da sessão de 5h, igual ao do modo completo -->
        <DataTemplate x:Key="ProviderGauge">
            <StackPanel Background="Transparent" Style="{StaticResource StaleFade}"
                        ToolTip="{StaticResource WeekTip}" ToolTipService.InitialShowDelay="150"
                        ToolTipService.ShowDuration="60000">
                <Grid HorizontalAlignment="Center">
                    <c:Gauge Width="100" Height="80" ShowScaleLabels="False"
                             Percent="{Binding SessionPercent}" HasData="{Binding HasData}"
                             Brand="{Binding Brand}" Logo="{Binding Logo}" LogoFill="{Binding LogoBrush}"
                             IsActive="{Binding IsActive}" SweepToken="{Binding SweepToken}"/>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Foreground="{StaticResource WarnBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Margin="0,-2,0,0"
                           Foreground="{StaticResource MutedBrush}">
                    <Run Text="5h ·"/>
                    <Run Text="{Binding SessionResetShort, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{Binding PanelBackground}" BorderBrush="{Binding PanelBorder}" BorderThickness="1"
            CornerRadius="16" Padding="4,6,4,4">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding VerticalScale}" ScaleY="{Binding VerticalScale}"/>
        </Border.LayoutTransform>
        <Grid>
        <StackPanel Style="{StaticResource ShadowWhenTransparent}">
            <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,0,4"
                       HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Cursor="SizeAll"
                       ToolTip="Arraste para mover"/>
            <ContentControl Content="{Binding Claude}" ContentTemplate="{StaticResource ProviderGauge}"
                            Visibility="{Binding ShowClaude, Converter={StaticResource BoolToVis}}"/>
            <Border Height="1" Margin="10,8" Background="{Binding PanelBorder}"
                    Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}"/>
            <ContentControl Content="{Binding Codex}" ContentTemplate="{StaticResource ProviderGauge}"
                            Visibility="{Binding ShowCodex, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Atualizar agora"
                        Click="Refresh_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Modo completo"
                        Click="Expand_Click"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimizar para a bandeja"
                        Click="Minimize_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Alça de redimensionar: só diminui (o tamanho padrão é o máximo) -->
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Margin="0,0,-3,-2"
               Cursor="SizeNWSE" ToolTip="Arraste para redimensionar (ou Ctrl + roda do mouse)"
               DragStarted="Resize_Started" DragDelta="Resize_Delta" DragCompleted="Resize_Completed">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 10,2 L 2,10 M 10,6 L 6,10" Stroke="{StaticResource MutedBrush}"
                              StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        </Grid>
    </Border>
</UserControl>
