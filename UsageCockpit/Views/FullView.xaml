<UserControl x:Class="UsageCockpit.Views.FullView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UsageCockpit.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ProviderColumn">
            <StackPanel Width="172" ToolTip="{Binding Tooltip}" Style="{StaticResource StaleFade}" Background="Transparent">
                <Grid Width="160" HorizontalAlignment="Center">
                    <c:Gauge Height="128"
                             Percent="{Binding SessionPercent}" HasData="{Binding HasData}"
                             Brand="{Binding Brand}" Logo="{Binding Logo}" LogoFill="{Binding LogoBrush}"
                             IsActive="{Binding IsActive}" SweepToken="{Binding SweepToken}"/>
                    <!-- Erro discreto: só o ícone, o texto aparece ao passar o mouse -->
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0"
                               Foreground="{StaticResource WarnBrush}" ToolTip="{Binding Error}" Background="Transparent"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Margin="0,0,0,8"
                           Foreground="{StaticResource MutedBrush}">
                    <Run Text="5h ·"/>
                    <Run Text="{Binding SessionResetText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
                <Grid Margin="6,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3">
                        <Run Text="semana ·"/>
                        <Run Text="{Binding WeekResetText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding WeekPercentText}" FontSize="11" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" Foreground="{Binding WeekBandBrush}"/>
                    <c:WeekBar Grid.Row="1" Percent="{Binding WeekPercent}" HasData="{Binding HasData}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{Binding PanelBackground}" BorderBrush="{Binding PanelBorder}" BorderThickness="1"
            CornerRadius="14" Padding="10,4,10,12">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding FullScale}" ScaleY="{Binding FullScale}"/>
        </Border.LayoutTransform>
        <Grid>
            <DockPanel Style="{StaticResource ShadowWhenTransparent}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Cursor="SizeAll"
                               ToolTip="Arraste para mover"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <!-- Pausar e continuar: pausado, mostra o play em destaque -->
                        <Button Click="Pause_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xE769;"/>
                                    <Setter Property="ToolTip" Value="Pausar as consultas"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Content" Value="&#xE768;"/>
                                            <Setter Property="ToolTip" Value="Continuar as consultas"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Atualizar agora"
                                Click="Refresh_Click"/>
                        <Button x:Name="MonitorButton" Style="{StaticResource IconButton}" Content="&#xE7F4;"
                                ToolTip="Escolher monitor" Click="Monitor_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="Modo compacto"
                                Click="Compact_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Configurações"
                                Click="Settings_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                                ToolTip="Minimizar para a bandeja" Click="Minimize_Click"/>
                    </StackPanel>
                    <TextBlock Text="{Binding UpdatedText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding Claude}" ContentTemplate="{StaticResource ProviderColumn}"
                                    Visibility="{Binding ShowClaude, Converter={StaticResource BoolToVis}}"/>
                    <Border Width="1" Margin="8,0" Background="{Binding PanelBorder}"
                            Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}"/>
                    <ContentControl Content="{Binding Codex}" ContentTemplate="{StaticResource ProviderColumn}"
                                    Visibility="{Binding ShowCodex, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>

            <!-- Alça de redimensionar: escala o painel inteiro, mantendo o estilo do cockpit -->
            <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Margin="0,0,-8,-10"
                   Cursor="SizeNWSE" ToolTip="Arraste para redimensionar (ou Ctrl + roda do mouse)"
                   DragStarted="Resize_Started" DragDelta="Resize_Delta" DragCompleted="Resize_Completed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 12,3 L 3,12 M 12,7 L 7,12 M 12,11 L 11,12" Stroke="{StaticResource MutedBrush}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</UserControl>
