<UserControl x:Class="UsageCockpit.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UsageCockpit.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="ProviderBars">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}" Background="Transparent"
                        Style="{StaticResource StaleFade}">
                <!-- Em uso: anel colorido girando em volta do logo -->
                <c:LogoBadge Logo="{Binding Logo}" LogoFill="{Binding LogoBrush}" Brand="{Binding Brand}"
                             IsActive="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="15"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="5h" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <c:MiniBar Grid.Column="1" SweepToken="{Binding SweepToken}" Percent="{Binding SessionPercent}" HasData="{Binding HasData}"
                               Brand="{Binding Brand}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding SessionPercentText}" FontSize="11" TextAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="sem" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <c:MiniBar Grid.Row="1" Grid.Column="1" SweepToken="{Binding SweepToken}" Percent="{Binding WeekPercent}" HasData="{Binding HasData}"
                               Brand="{Binding Brand}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeekPercentText}" FontSize="11"
                               TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="4,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}" ToolTip="{Binding Error}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{Binding PanelBackground}" BorderBrush="{Binding PanelBorder}" BorderThickness="1"
            CornerRadius="23" Padding="10,7,6,7">
        <StackPanel Orientation="Horizontal" Style="{StaticResource ShadowWhenTransparent}">
            <TextBlock Text="&#xE784;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Cursor="SizeAll"
                       ToolTip="Arraste para mover"/>
            <ContentControl Content="{Binding Claude}" ContentTemplate="{StaticResource ProviderBars}"
                            Visibility="{Binding ShowClaude, Converter={StaticResource BoolToVis}}"/>
            <Border Width="1" Height="28" Margin="12,0" Background="{Binding PanelBorder}"
                    Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}"/>
            <ContentControl Content="{Binding Codex}" ContentTemplate="{StaticResource ProviderBars}"
                            Visibility="{Binding ShowCodex, Converter={StaticResource BoolToVis}}"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Atualizar agora" Margin="6,0,0,0"
                    Click="Refresh_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Modo completo"
                    Click="Expand_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimizar para a bandeja"
                    Click="Minimize_Click"/>
        </StackPanel>
    </Border>
</UserControl>
