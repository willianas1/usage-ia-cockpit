<UserControl x:Class="UsageCockpit.Views.UltraCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UsageCockpit.Controls"
             TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <!--
        Só os números: sessão de 5h em destaque, na cor da faixa, e o semanal pequeno ao lado.
        Sem botões: o logo mostra os indicadores completos ao passar o mouse e atualiza a conta no clique;
        clique duplo fora do logo abre o modo completo e o clique direito, o menu.
        Texto em modo Ideal com suavização em tons de cinza: os números grandes ficavam serrilhados no
        modo Display da janela (contornos presos ao pixel, e sem ClearType sobre o fundo transparente).
        Números em Segoe UI, a fonte da janela: o Cascadia Mono só existe como fonte variável, e o WPF
        simula o negrito dela engrossando o traço, o que deixava os dígitos irregulares.
    -->
    <UserControl.Resources>
        <DataTemplate x:Key="ProviderNumbers">
            <StackPanel Orientation="Horizontal" Background="Transparent" Style="{StaticResource StaleFade}">
                <Button Style="{StaticResource LogoButton}" ToolTip="{StaticResource ProviderTip}" Click="Logo_Click"
                        VerticalAlignment="Center" Margin="0,0,3,0">
                    <c:LogoBadge Logo="{Binding Logo}" LogoFill="{Binding LogoBrush}" Brand="{Binding Brand}"
                                 IsActive="{Binding ShowRing}"/>
                </Button>
                <TextBlock Text="{Binding SessionPercentText}" FontSize="20" FontWeight="Bold"
                           Foreground="{Binding SessionLevelBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center" Margin="5,1,0,0">
                    <TextBlock Text="sem" FontSize="10" LineHeight="11" LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding WeekPercentText}" FontSize="11" FontWeight="SemiBold" LineHeight="12"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{Binding WeekBrush}"/>
                </StackPanel>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="4,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{Binding PanelBackground}" BorderBrush="{Binding PanelBorder}" BorderThickness="1"
            CornerRadius="18" Padding="8,2,12,2">
        <StackPanel Orientation="Horizontal" Style="{StaticResource ShadowWhenTransparent}">
            <TextBlock Text="&#xE784;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,4,0"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Cursor="SizeAll"/>
            <ContentControl Content="{Binding Claude}" ContentTemplate="{StaticResource ProviderNumbers}"
                            Visibility="{Binding ShowClaude, Converter={StaticResource BoolToVis}}"/>
            <Border Width="1" Height="20" Margin="10,0" Background="{Binding PanelBorder}"
                    Visibility="{Binding ShowDivider, Converter={StaticResource BoolToVis}}"/>
            <ContentControl Content="{Binding Codex}" ContentTemplate="{StaticResource ProviderNumbers}"
                            Visibility="{Binding ShowCodex, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </Border>
</UserControl>
