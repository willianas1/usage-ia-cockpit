<Window x:Class="UsageCockpit.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage IA Cockpit — Envio para API" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="True"
        Background="#15181D" Foreground="#D0D7DE" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D7DE"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,6,20,20">
        <TextBlock Text="ENVIO" Style="{StaticResource Section}"/>
        <CheckBox x:Name="EnabledCheck" Content="Enviar o uso para uma API"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Vão só percentuais, horários de reset e se a ferramenta está em uso. Tokens e logins dos provedores nunca saem desta máquina."/>

        <TextBlock Text="URL BASE" Style="{StaticResource Section}"/>
        <TextBox x:Name="UrlBox" Padding="4,3" TextChanged="Url_Changed"/>
        <TextBlock x:Name="EndpointText" Style="{StaticResource Hint}" FontFamily="Cascadia Mono, Consolas"/>

        <TextBlock Text="CHAVE DE AUTENTICAÇÃO" Style="{StaticResource Section}"/>
        <PasswordBox x:Name="KeyBox" Padding="4,3"/>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Enviada como Authorization: Bearer &lt;chave&gt;. Fica guardada cifrada com a sua conta do Windows."/>

        <TextBlock Text="STATUS" Style="{StaticResource Section}"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>

        <Expander Header="Como implementar a API" Foreground="#D0D7DE" Margin="0,16,0,0">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Hint}" Foreground="#D0D7DE" xml:space="preserve">POST {URL base}/v1/usage
Authorization: Bearer &lt;chave&gt;
Content-Type: application/json</TextBlock>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                    Responda 2xx para aceitar. 401/403 fazem o app parar até a chave ser corrigida; 429 com
                    Retry-After faz o app esperar; qualquer outra resposta é tentada de novo com espera crescente.
                    O app envia depois de cada leitura, quando uma ferramenta começa ou para de trabalhar e,
                    sem mudanças, a cada 5 minutos. Redirecionamentos não são seguidos.
                </TextBlock>
                <TextBlock Text="EXEMPLO COM OS SEUS DADOS ATUAIS" Style="{StaticResource Section}"/>
                <TextBox x:Name="ExampleBox" IsReadOnly="True" Height="220" FontFamily="Cascadia Mono, Consolas"
                         FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#0F1216" Foreground="#D0D7DE" BorderBrush="#2D333B"/>
                <DockPanel Margin="0,8,0,0">
                    <Button Content="Copiar exemplo" Click="CopyExample_Click"/>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11">
                        <Hyperlink x:Name="DocsLink" Foreground="#58A6FF" Click="Docs_Click">Especificação completa (docs/API.md)</Hyperlink>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Expander>

        <DockPanel Margin="0,20,0,0">
            <Button x:Name="TestButton" Content="Testar conexão" Click="Test_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="14,4" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Salvar" Padding="18,4" Margin="0" Click="Save_Click" IsDefault="True"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
