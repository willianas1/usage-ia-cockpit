<Application x:Class="UsageCockpit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D0D7DE"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#EF9F27"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#22272E"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A3038"/>
                                <Setter Property="Foreground" Value="#F0F3F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sombra nos textos quando o fundo está bem transparente -->
        <Style x:Key="ShadowWhenTransparent" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseTextShadow}" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="1" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StaleFade" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStale}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
